DATABASE_URL=postgres://schedule:schedule@localhost:5432/schedule
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# Optional extra browser origins, comma-separated. localhost, 127.0.0.1:3000, and the schedule.diyforvisa.com hosts are already trusted.
# BETTER_AUTH_TRUSTED_ORIGINS=https://schedule.example.com

# Password reset codes. Production needs EMAIL_FROM plus Resend or SMTP.
# Locally, with neither set, the code is printed by `npm run dev`.
# Keep the angle brackets. Do not wrap the value in quotes.
# EMAIL_FROM=搭子日程 <noreply@diyforvisa.com>
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@qq.com
# SMTP_PASS=
# Print codes instead of sending them. Leave this unset in production.
# EMAIL_OTP_ALLOW_LOG=true
